# Gere sua chave em https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
# Opcional: proxy HTTP(S) para chamadas da Steam. Deixe vazio para conexão direta.
STEAM_PROXY=
# Opcional: preenche o campo inicial da aplicação e é usado pelo importador.
# Aceita https://steamcommunity.com/id/seu-perfil/ ou SteamID64.
STEAM_PROFILE=
